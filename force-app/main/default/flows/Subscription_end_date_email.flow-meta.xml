    <decisions>
        <name>check_number_of_days_and_send_email_accordingly</name>
        <label>check number of days and send email accordingly</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subscription_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>todayDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_today</targetReference>
            </connector>
            <label>today</label>
        </rules>
        <rules>
            <name>X7_days_from_now</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subscription_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>add7days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>send_email_7_days</targetReference>
            </connector>
            <label>7 days from now</label>
        </rules>
        <rules>
            <name>X30_days_from_now</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subscription_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>add30days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>send_email_30_days</targetReference>
            </connector>
            <label>30 days from now</label>
        </rules>
    </decisions>
    <description>Problem: For Accounts with a Subscription_End_Date__c, send 3 reminders: 30 days before end date 7 days before end date On the end date itself Flow Type: Scheduled-Triggered Flow (runs daily).</description>
    <environments>Default</environments>
    <formulas>
        <name>add30days</name>
        <dataType>Date</dataType>
        <expression>TODAY()+30</expression>
    </formulas>
    <formulas>
        <name>add7days</name>
        <dataType>Date</dataType>
        <expression>TODAY()+7</expression>
    </formulas>
    <formulas>
        <name>todayDate</name>
        <dataType>Date</dataType>
        <expression>today()</expression>
    </formulas>
